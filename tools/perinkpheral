#!/bin/sh
# SPDX-License-Identifier: MIT
# The perINKpheral tools: build, check and run applications, on a device or in the
# simulator; make a catalog; and what the project makes of its sources. `perinkpheral` with
# no arguments says what it does.
#
# tools/cli, with tools/core in it, built on first use and again when either's sources
# change; it needs Java 21 or later (JAVA_HOME, or java on PATH). The CLion plugin uses the
# same core as a library.
here=$(cd "$(dirname "$0")" && pwd)
cli="$here/cli"
core="$here/core"
jar="$cli/build/libs/perinkpheral.jar"
is_stale() {
    [ ! -f "$jar" ] || [ -n "$(find "$cli/src" "$core/src" "$cli/build.gradle.kts" "$core/build.gradle.kts" \
                                  -newer "$jar" 2>/dev/null | head -1)" ]
}
# Check freshness under the same lock on every invocation: an archive's timestamp
# says nothing about whether a concurrent build has finished writing it.
mkdir -p "$cli/build/libs" || exit 1
lock="$cli/build/.building"
waited=0
until mkdir "$lock" 2>/dev/null; do
    waited=$((waited + 1))
    if [ "$waited" -gt 600 ]; then
        echo "Timed out waiting for $lock; remove it if no build is running." >&2
        exit 1
    fi
    sleep 1
done
temporary=
cleanup() {
    if [ -n "$temporary" ]; then rm -rf "$temporary"; fi
    rmdir "$lock" 2>/dev/null
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 143' TERM
if is_stale; then
    # Keep the previous jar intact on failure. A sibling directory makes the final
    # rename atomic on both macOS and Linux, even when TMPDIR is on another volume.
    temporary=$(mktemp -d "$cli/build/libs/.cli.XXXXXX") || exit 1
    (cd "$cli" && ./gradlew -q "-PcliJarDirectory=$temporary" cli) >&2 || exit 1
    mv -f "$temporary/perinkpheral.jar" "$jar" || exit 1
fi
cleanup
trap - 0 INT TERM
if [ -n "$JAVA_HOME" ]; then java="$JAVA_HOME/bin/java"; else java=java; fi
exec "$java" -Dperinkpheral.root="$(dirname "$here")" -jar "$jar" "$@"
