include("${PATCH_HELPER}")
find_package(Git REQUIRED)
set(repository "${CMAKE_CURRENT_BINARY_DIR}/patch-build-dirs")
file(MAKE_DIRECTORY "${repository}")
execute_process(COMMAND "${GIT_EXECUTABLE}" init "${repository}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not create the patch regression repository: ${error}")
endif()
file(WRITE "${repository}/.gitignore" "build*/\n")
file(SHA256 "${UPSTREAM}" upstream_hash)
foreach(consumer host release debug)
    set(output_dir "${repository}/build-${consumer}/patched-mbedtls")
    perinkpheral_patch_mbedtls_x509("${UPSTREAM}" "${output_dir}")
    # Reconfiguration must regenerate from upstream, including over a foreign copy.
    perinkpheral_patch_mbedtls_x509("${UPSTREAM}" "${output_dir}")
    file(WRITE "${output_dir}/library/x509.c" "stale generated source\n")
    perinkpheral_patch_mbedtls_x509("${UPSTREAM}" "${output_dir}")
endforeach()
file(SHA256 "${UPSTREAM}" actual_hash)
if(NOT actual_hash STREQUAL upstream_hash)
    message(FATAL_ERROR "Patch generation modified the upstream source")
endif()
